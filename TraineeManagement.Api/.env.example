# Database
ConnectionStrings__DefaultConnection=YOUR_DB_CONNECTION_STRING
ConnectionStrings__RedisConnection=YOUR_REDIS_CONNECTION_STRING

# JWT Settings
JwtSettings__SecretKey=YOUR_JWT_SECRET_KEY
JwtSettings__Issuer=YOUR_JWT_ISSUER
JwtSettings__Audience=YOUR_JWT_AUDIENCE
JwtSettings__ExpiryMinutes=EXPIRY_MINUTES

# File Storage
FileStorage__RootPath=YOUR_FILE_ROOT_PATH
FileStorage__MaxFileSizeMb=FILE_MAX_SIZE
FileStorage__AllowedExtensions__0=.jpg
FileStorage__AllowedExtensions__1=.jpeg
FileStorage__AllowedExtensions__2=.png
FileStorage__AllowedExtensions__3=.pdf

# Redis
Redis__ConnectionString=YOUR_REDIS_CONNECTION_STRING

# RabbitMQ
RabbitMq__Host=YOUR_RABBITMQ_HOST
RabbitMq__Port=YOUR_RABBITMQ_PORT
RabbitMq__Username=YOUR_RABBITMQ_USERNAME
RabbitMq__Password=YOUR_RABBITMQ_PASSWORD
RabbitMq__QueueName=YOUR_QUEUE_NAME

# Interservice URLs
InterserviceUrls__TraineeDirectory=YOUR_INTERSERVICE_URL
